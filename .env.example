# Copy to .env for local use. .env is git-ignored; never commit real values.
# Optional: point commands at a different project folder.
# TMA_HOME=C:\path\to\the-midnight-archive

# ---------------------------------------------------------------------------
# Paid LLM adapter (OFF by default).
# Phase 1 uses the free offline idea generator. The adapter below is only used
# when BOTH TMA_ALLOW_PAID_API=1 and the --allow-paid-api CLI flag are given.
# Never set these until you have deliberately chosen to spend money.
# ---------------------------------------------------------------------------
TMA_ALLOW_PAID_API=0
# OPENAI_API_KEY=
# TMA_LLM_MODEL=

# OpenAI-compatible endpoint (configured in config/settings.yaml as well).
# OPENAI_BASE_URL=https://freebuff.com/api/v1/paid

# ---------------------------------------------------------------------------
# Phase 2/3 placeholders - no paid service is called by Phase 1 code.
# ---------------------------------------------------------------------------
# TTS engine: piper (local, free) is the intended default.
# TMA_TTS_ENGINE=piper
# TMA_TTS_VOICE=
