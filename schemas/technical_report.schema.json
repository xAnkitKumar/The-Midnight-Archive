{
  "$defs": {
    "TechnicalCheckItem": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "name",
        "passed",
        "detail"
      ],
      "title": "TechnicalCheckItem",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "video_id": {
      "title": "Video Id",
      "type": "string"
    },
    "mp4_path": {
      "title": "Mp4 Path",
      "type": "string"
    },
    "mp4_sha256": {
      "title": "Mp4 Sha256",
      "type": "string"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/TechnicalCheckItem"
      },
      "title": "Checks",
      "type": "array"
    },
    "passed": {
      "title": "Passed",
      "type": "boolean"
    },
    "blocking_issues": {
      "items": {
        "type": "string"
      },
      "title": "Blocking Issues",
      "type": "array"
    },
    "probe": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "number"
          },
          {
            "type": "integer"
          },
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Probe",
      "type": "object"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "video_id",
    "mp4_path",
    "mp4_sha256",
    "passed"
  ],
  "title": "The Midnight Archive Technical Report",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
