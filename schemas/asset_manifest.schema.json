{
  "$defs": {
    "AssetManifestEntry": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "title": "Asset Id",
          "type": "string"
        },
        "video_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Video Id"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "license": {
          "title": "License",
          "type": "string"
        },
        "commercial_use": {
          "default": true,
          "title": "Commercial Use",
          "type": "boolean"
        },
        "attribution": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attribution"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "added_at": {
          "format": "date-time",
          "title": "Added At",
          "type": "string"
        }
      },
      "required": [
        "asset_id",
        "kind",
        "path",
        "source",
        "license",
        "sha256"
      ],
      "title": "AssetManifestEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "assets": {
      "items": {
        "$ref": "#/$defs/AssetManifestEntry"
      },
      "title": "Assets",
      "type": "array"
    }
  },
  "title": "The Midnight Archive Asset Manifest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
