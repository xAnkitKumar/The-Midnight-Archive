  "cues": [
    {
      "index": 1,
      "start": 0.2,
      "end": 2.79,
      "text": "Elias's paper had his obituary."
    },
    {
      "index": 2,
      "start": 3.211,
      "end": 5.401,
      "text": "It arrived a day\nearly: his name,"
    },
    {
      "index": 3,
      "start": 5.511,
      "end": 8.061,
      "text": "his apartment, a fire at 3:07."
    },
    {
      "index": 4,
      "start": 9.258,
      "end": 10.008,
      "text": "He was alive."
    },
    {
      "index": 5,
      "start": 10.894,
      "end": 11.784,
      "text": "He had no subscription."
    },
    {
      "index": 6,
      "start": 11.784,
      "end": 15.164,
      "text": "Underneath, in small\nprint: one name per"
    },
    {
      "index": 7,
      "start": 15.164,
      "end": 19.363,
      "text": "fire. At 2:40,\nElias knocked on 4A."
    },
    {
      "index": 8,
      "start": 19.753,
      "end": 22.083,
      "text": "Mara's heater had been\nsparking all week."
    },
    {
      "index": 9,
      "start": 22.7,
      "end": 24.35,
      "text": "She'd asked him to fix it."
    },
    {
      "index": 10,
      "start": 24.5,
      "end": 25.95,
      "text": "He told her to call the super."
    },
    {
      "index": 11,
      "start": 26.725,
      "end": 28.655,
      "text": "He took the stairs\nand didn't look"
    },
    {
      "index": 12,
      "start": 28.655,
      "end": 31.248,
      "text": "back. From the\nhotel, he watched the"
    },
    {
      "index": 13,
      "start": 31.248,
      "end": 31.928,
      "text": "smoke rise."
    },
    {
      "index": 14,
      "start": 31.928,
      "end": 35.508,
      "text": "At 3:07, 4B burned."
    },
    {
      "index": 15,
      "start": 36.139,
      "end": 37.649,
      "text": "The next paper\nwaited at the front"
    },
    {
      "index": 16,
      "start": 37.649,
      "end": 39.469,
      "text": "desk. Same fire."
    },
    {
      "index": 17,
      "start": 39.799,
      "end": 40.649,
      "text": "Same hour."
    },
    {
      "index": 18,
      "start": 40.879,
      "end": 41.629,
      "text": "Different name."
    },
    {
      "index": 19,
      "start": 42.298,
      "end": 43.048,
      "text": "Mara Kwan."
    },
    {
      "index": 20,
      "start": 43.418,
      "end": 44.688,
      "text": "Apartment 4A."
    },
    {
      "index": 21,
      "start": 45.058,
      "end": 46.848,
      "text": "It said she'd entered 4B to warn"
    },
    {
      "index": 22,
      "start": 46.848,
      "end": 49.901,
      "text": "him. Elias laid the\ntwo obituaries side"
    },
    {
      "index": 23,
      "start": 49.901,
      "end": 50.841,
      "text": "by side."
    },
    {
      "index": 24,
      "start": 51.211,
      "end": 51.561,
      "text": "His name."
    },
    {
      "index": 25,
      "start": 51.561,
      "end": 55.842,
      "text": "Mara's. The paper wasn't\npredicting the future."
    },
    {
      "index": 26,
      "start": 56.586,
      "end": 58.776,
      "text": "It was choosing who paid for it."
    }
  ]
