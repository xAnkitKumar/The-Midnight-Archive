  "cues": [
    {
      "index": 1,
      "start": 0.21,
      "end": 2.35,
      "text": "Elias's paper had his obituary."
    },
    {
      "index": 2,
      "start": 2.83,
      "end": 5.07,
      "text": "It arrived a day\nearly: his name,"
    },
    {
      "index": 3,
      "start": 5.27,
      "end": 7.51,
      "text": "his apartment, a fire at 3:07."
    },
    {
      "index": 4,
      "start": 8.35,
      "end": 9.03,
      "text": "He was alive."
    },
    {
      "index": 5,
      "start": 10.276,
      "end": 11.186,
      "text": "He had no subscription."
    },
    {
      "index": 6,
      "start": 11.216,
      "end": 13.326,
      "text": "Underneath, in small print:"
    },
    {
      "index": 7,
      "start": 13.356,
      "end": 15.096,
      "text": "one name per fire."
    },
    {
      "index": 8,
      "start": 15.615,
      "end": 18.235,
      "text": "At 2:40, Elias knocked on 4A."
    },
    {
      "index": 9,
      "start": 18.855,
      "end": 20.815,
      "text": "Mara's heater had been\nsparking all week."
    },
    {
      "index": 10,
      "start": 21.135,
      "end": 22.455,
      "text": "She'd asked him to fix it."
    },
    {
      "index": 11,
      "start": 22.715,
      "end": 24.055,
      "text": "He told her to call the super."
    },
    {
      "index": 12,
      "start": 24.555,
      "end": 25.325,
      "text": "He took the stairs"
    },
    {
      "index": 13,
      "start": 25.355,
      "end": 26.535,
      "text": "and didn't look back."
    },
    {
      "index": 14,
      "start": 26.915,
      "end": 27.885,
      "text": "From the hotel, he"
    },
    {
      "index": 15,
      "start": 27.915,
      "end": 29.275,
      "text": "watched the smoke rise."
    },
    {
      "index": 16,
      "start": 29.915,
      "end": 32.015,
      "text": "At 3:07, 4B burned."
    },
    {
      "index": 17,
      "start": 32.655,
      "end": 33.565,
      "text": "The next paper waited"
    },
    {
      "index": 18,
      "start": 33.595,
      "end": 34.655,
      "text": "at the front desk."
    },
    {
      "index": 19,
      "start": 35.075,
      "end": 36.035,
      "text": "Same fire."
    },
    {
      "index": 20,
      "start": 36.315,
      "end": 37.095,
      "text": "Same hour."
    },
    {
      "index": 21,
      "start": 37.275,
      "end": 37.995,
      "text": "Different name."
    },
    {
      "index": 22,
      "start": 39.165,
      "end": 40.055,
      "text": "Mara Kwan."
    },
    {
      "index": 23,
      "start": 40.085,
      "end": 41.445,
      "text": "Apartment 4A."
    },
    {
      "index": 24,
      "start": 41.665,
      "end": 42.475,
      "text": "It said she'd entered"
    },
    {
      "index": 25,
      "start": 42.505,
      "end": 43.925,
      "text": "4B to warn him."
    },
    {
      "index": 26,
      "start": 44.485,
      "end": 45.255,
      "text": "Elias laid the two"
    },
    {
      "index": 27,
      "start": 45.285,
      "end": 47.145,
      "text": "obituaries side by side."
    },
    {
      "index": 28,
      "start": 47.485,
      "end": 48.135,
      "text": "His name."
    },
    {
      "index": 29,
      "start": 48.345,
      "end": 49.085,
      "text": "Mara's."
    },
    {
      "index": 30,
      "start": 49.906,
      "end": 51.966,
      "text": "The paper wasn't\npredicting the future."
    },
    {
      "index": 31,
      "start": 52.426,
      "end": 54.366,
      "text": "It was choosing who paid for it."
    }
  ],
